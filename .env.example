SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave this line commented out locally to fall back to SQLite.
# DATABASE_URL=postgres://user:password@db:5432/portfolio

# Only needed for `docker-compose up` (fills in DATABASE_URL for the db/web/celery services).
# Pick a real password — docker-compose will refuse to start the db service without one.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=hello@example.com

# Only needed in production (config/settings/production.py): persistent media storage
# on Cloudinary, since Railway's container filesystem is wiped on every redeploy.
# Get this from the Cloudinary dashboard (Settings > Access Keys) after creating a free account.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
