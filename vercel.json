{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "excludeFiles": "{.venv/**,media/**,staticfiles/**,db.sqlite3,.env,**/__pycache__/**,**/tests.py,**/tests/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
